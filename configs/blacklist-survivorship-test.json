{
  // ==========================================================================
  // SURVIVORSHIP-BIAS TEST BLACKLIST
  // ==========================================================================
  // Load this INSTEAD of blacklist-binance.json to reconstruct the pair
  // universe as it looked to a trader on 2025-02-16, rather than as it looks
  // with 18 months of hindsight.
  //
  // WHY:
  //   configs/blacklist-binance.json excludes 40 of the 160 pairs in the CI
  //   pairlist. Checked against Binance's live market list on 2026-08-22,
  //   ALL 40 are now delisted from Binance spot -- a 100% hit rate. That is
  //   not a risk filter, it is a survivorship filter: the entries were added
  //   as each coin died (the file's own comments date them: "Binance delist
  //   2026-08-17", "Token collapse 2026-07-21", "Hacked/depeg 2026-07-24",
  //   "Binance monitoring tag 2026-08-11"...). Backtesting against the
  //   surviving 120 measures the strategy on a universe selected by the
  //   outcome it is being tested for.
  //
  // WHAT THIS FILE KEEPS:
  //   Only STRUCTURAL exclusions -- ones a trader could have written in
  //   Feb 2025 without knowing the future, because they describe what an
  //   instrument IS, not what happened to it:
  //     - leveraged tokens, fiat pairs, stablecoins
  //     - fan tokens, tokenized stocks, tokenized commodities
  //     - exchange-naming artifacts (1000* prefixes) and the exchange's
  //       own token
  //
  // WHAT THIS FILE DROPS (all hindsight-based):
  //   delisting watchlists, post-hoc "token collapse" / "hacked" / "depeg"
  //   entries, the large "Others" bucket, the meme bucket, and the
  //   "low cap (out of CoinGecko top-750)" bucket -- that last one is ranked
  //   by TODAY's market cap, so it too encodes the outcome.
  //
  // USAGE (note: replaces the normal blacklist in the config chain)
  //   --config=configs/exampleconfig.json
  //   --config=configs/exampleconfig_secret.json
  //   --config=configs/trading_mode-spot.json
  //   --config=configs/blacklist-survivorship-test.json
  //   --config=configs/pairlist-backtest-static-binance-spot-usdt.json
  //
  // Requires: scripts/fetch_delisted_data.py to have recovered OHLCV for the
  // delisted pairs from data.binance.vision first.
  // ==========================================================================
  "exchange": {
    "pair_blacklist": [
      // --- Exchange naming artifacts ---------------------------------------
      "(1000.*).*/.*",
      // --- Exchange's own token --------------------------------------------
      "(RIF|BNB)/.*",
      // --- Leveraged tokens -------------------------------------------------
      ".*(_PREMIUM|BEAR|BULL|HALF|HEDGE|UP|DOWN|[1235][SL])/.*",
      // --- Fiat -------------------------------------------------------------
      "(ARS|AUD|BIDR|BRZ|BRL|CAD|CHF|EUR|GBP|HKD|IDRT|JPY|NGN|PLN|RON|RUB|SGD|TRY|UAH|USD|ZAR)/.*",
      // --- Stablecoins ------------------------------------------------------
      "(AEUR|FDUSD|BUSD|CUSD|CUSDT|DAI|AXG|SUSD|TUSD|USDC|USDN|USDP|USDT|VAI|UST|USTC|AUSD|FDUSD|EURI|USDS|XUSD|USD1|RLUSD|U)/.*",
      // --- Fan tokens -------------------------------------------------------
      "(ACM|AFA|ALA|ALL|ALPINE|APL|ASR|ATM|BAR|CAI|CHZ|CITY|FOR|GAL|GOZ|IBFK|JUV|LEG|LOCK-1|NAVI|NMR|NOV|PFL|PSG|ROUSH|STV|TH|TRA|UCH|UFC|YBO)/.*",
      // --- Tokenized stocks -------------------------------------------------
      ".*STOCK/.*",
      "(AAPL|AMD|ARM|ASTS|CRWV|DELL|GOOGL|IREN|LITE|MRVL|MU|NBIS|QCOM|SNDK|SPCX|AAOI|AMZN|APLD|AVGO|BABA|BE|COHR|HOOD|INTC|IONQ|META|PLTR|SQQQ|TQQQ|TSLA|TSM)/.*",
      // --- Tokenized commodities --------------------------------------------
      "(CL|BZ|NATGAS|XPT)/.*"
    ]
  }
}
